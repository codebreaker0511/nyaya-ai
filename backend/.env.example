DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/nyaya_ai

# LLM: any OpenAI-compatible chat-completions API
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-sol
LLM_TIMEOUT_SECONDS=45
EMBEDDING_MODEL=text-embedding-3-small

ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
SESSION_EXPIRY_DAYS=7
# Production (HTTPS, frontend on a different domain): COOKIE_SECURE=true, COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

MAX_MESSAGE_CHARS=2000
HISTORY_MESSAGES=6

# RAG (retrieval over the Constitution index)
RAG_ENABLED=true
RAG_TOP_K=4
RAG_MIN_SCORE=0.30
