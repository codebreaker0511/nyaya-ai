DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/nyaya_ai

# LLM: any OpenAI-compatible chat-completions API
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-sol
LLM_TIMEOUT_SECONDS=45
# Output cap per call (lets the quota reserve the worst case). Includes reasoning tokens on reasoning models.
LLM_MAX_OUTPUT_TOKENS=2000
LLM_TITLE_MAX_OUTPUT_TOKENS=300
# "max_completion_tokens" for current OpenAI models; "max_tokens" for some other OpenAI-compatible providers
LLM_MAX_TOKENS_PARAM=max_completion_tokens
EMBEDDING_MODEL=text-embedding-3-small

ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
SESSION_EXPIRY_DAYS=7
# Production (HTTPS, frontend on a different domain): COOKIE_SECURE=true, COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

MAX_MESSAGE_CHARS=2000
HISTORY_MESSAGES=6

# RAG (retrieval over the Constitution index)
RAG_ENABLED=true
RAG_TOP_K=4
RAG_MIN_SCORE=0.30

# Abuse protection (counters are stored in PostgreSQL; 0 disables a rate limit)
DAILY_TOKEN_LIMIT=40000
GLOBAL_DAILY_TOKEN_LIMIT=2000000
QUOTA_TIMEZONE=UTC
SESSION_RATE_LIMIT_PER_MINUTE=5
IP_RATE_LIMIT_PER_MINUTE=10
SESSION_CREATE_LIMIT_PER_IP_PER_HOUR=30
# Number of reverse proxies that append to X-Forwarded-For. 0 = ignore the header (local development).
# Must be set correctly in production, see README ("Abuse protection").
TRUSTED_PROXY_HOPS=0

# Tests only: a SEPARATE, disposable database. DB tests are skipped when this is not set.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/nyaya_ai_test
